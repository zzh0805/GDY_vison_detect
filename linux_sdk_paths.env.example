# 复制为 linux_sdk_paths.env，再按 Ubuntu ARM64 工控机的实际路径修改。

# 目录中必须直接包含 ARM64 libOpenNI2.so。
export SURFACEPRO50_OPENNI2_REDIST="/opt/SurfacePro50/OpenNI2/Redist"

# 目录中应包含 openni/__init__.py；已安装进Python环境时可留空。
export SURFACEPRO50_PYTHON_PATH="/opt/SurfacePro50/python"

# 厂商其他 .so 目录；多个目录用冒号分隔。
export SURFACEPRO50_LIBRARY_PATH="/opt/SurfacePro50/lib"

# JAKA ARM64 Python SDK，目录中应包含 jkrc.so。
# 正式视觉服务不连接JAKA；field_test脚本会使用它。
export JAKA_SDK_PATH="/opt/JAKA/SDK/Linux/python3/aarch64-linux-gnu"

# libjakaAPI.so 与 jkrc.so 在同一目录时保持如下设置。
export JAKA_LIBRARY_PATH="${JAKA_SDK_PATH}"

# 新工程默认使用的Conda环境名。
export VISION_CONDA_ENV="ur_odcam"

# MinIO快照上传凭据。真实值只填写到被.gitignore忽略的linux_sdk_paths.env，
# 不要写入workflow.yaml、示例文件、日志或Git提交。
export GDY_MINIO_ACCESS_KEY=""
export GDY_MINIO_SECRET_KEY=""
